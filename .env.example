# Copie este archivo como ".env" (misma carpeta que docker-compose.yml) y complete los valores.
# El archivo ".env" contiene claves: NUNCA se sube a GitHub (esta en .gitignore).

# Conexion de pacientes_service a SQL Server (login SQL "asilo_app", no el de Windows).
# Si Docker Desktop corre en la misma PC que SQL Server, use host.docker.internal como servidor.
DATABASE_URL=mssql+pyodbc://asilo_app:CAMBIAR_CLAVE@host.docker.internal,1433/AsiloCabezaAlgodon?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# Correo saliente (notificaciones a los familiares). Con Gmail use una "contrasena de aplicacion".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo@ejemplo.com
SMTP_PASSWORD=contrasena_de_aplicacion
