# Copia este archivo como ".env" (misma carpeta del docker-compose.yml).
# Ya NO se necesita JWT_SECRET_KEY: el login ahora vive en el backend .NET
# con Entity Framework (autenticacion de Windows), no en un microservicio.
#
# Solo pacientes_service necesita conectarse a SQL Server via Docker/Linux,
# por lo que sigue requiriendo un login SQL (no de Windows). Si ya creaste
# el login "asilo_app" en pasos anteriores, reutilizalo aqui.
#
# Si Docker Desktop corre en la misma PC que SQL Server, usa
# "host.docker.internal" en vez de "localhost" como servidor.

DATABASE_URL=mssql+pyodbc://asilo_app:TU_PASSWORD@host.docker.internal,1433/AsiloCabezaAlgodon?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
