# ===========================================================================
# Variables del despliegue en la nube (docker-compose.cloud.yml)
# Copia este archivo como ".env.cloud" y completa los valores.
# ".env.cloud" NUNCA se sube a GitHub (esta en .gitignore).
# ===========================================================================

# Nombre publico por el que se entrara al sistema (sin https://).
# Pruebas en tu PC: localhost.   En Azure: el nombre DNS de la maquina virtual.
DOMINIO=localhost

# Contrasena del administrador de SQL Server (usuario "sa").
# Use SOLO letras y numeros, minimo 12, con mayusculas, minusculas y digitos.
SA_PASSWORD=CambiaEstaClave2026

# Contrasena del usuario "asilo_app", con el que la aplicacion se conecta a la
# base (no usa "sa"). Mismas reglas: solo letras y numeros, minimo 12.
APP_DB_PASSWORD=

# Contrasenas de los usuarios del sistema. OBLIGATORIAS: el sistema no arranca
# con las claves de prueba. Elija claves fuertes y distintas.
PASS_ADMIN=
PASS_DOCTOR=
PASS_ENFERMERO=
PASS_FARMACIA=
PASS_FUNDACION=
PASS_LABORATORIO=

# Correo saliente (notificaciones a los familiares). Para Gmail use una
# "contrasena de aplicacion" y el puerto 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
