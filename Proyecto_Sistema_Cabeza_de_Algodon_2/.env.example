# Copia este archivo como ".env" (en la misma carpeta del docker-compose.yml)
# y ajusta usuario/contraseña/servidor según tu SQL Server.
#
# Requisito: tu instancia de SQL Server debe tener habilitado el modo de
# autenticación mixto ("SQL Server and Windows Authentication mode") y debes
# tener un login de SQL Server (no de Windows) con permisos sobre la base
# AsiloCabezaAlgodon. La autenticación integrada de Windows (Trusted_Connection)
# que usa tu proyecto .NET NO funciona desde los contenedores Docker (Linux).
#
# Si tu SQL Server corre en la misma PC donde levantas Docker Desktop (Windows),
# normalmente el host se llama "host.docker.internal" en vez de "localhost".

DATABASE_URL=mssql+pyodbc://usuario_sql:tu_password@host.docker.internal,1433/AsiloCabezaAlgodon?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# Clave secreta para firmar los tokens del login_service. Usa una cadena
# larga y aleatoria propia (no la dejes así para la entrega final).
JWT_SECRET_KEY=cambia-esta-clave-por-una-segura-para-el-proyecto
