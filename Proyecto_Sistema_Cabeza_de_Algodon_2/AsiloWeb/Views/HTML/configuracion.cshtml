      <main class="area-trabajo">
    <h1><i class="fa-solid fa-gear"></i> Configuración del Sistema</h1>
    <p>Ajustes generales del asilo, parámetros técnicos y control de credenciales.</p>

    <!-- TARJETA 1: PARÁMETROS GENERALES DE LA INSTITUCIÓN -->
    <div class="formulario-datos">
        <h2><i class="fa-solid fa-building"></i> Datos de la Institución</h2>
        <div class="grupo-campo">
            <label>Nombre del Asilo / Centro:</label>
            <input type="text" value="Asilo Cabeza de Algodón">
        </div>
        <div class="grupo-campo">
            <label>Dirección Física:</label>
            <input type="text" value="Calle Principal 12-45, Zona 1">
        </div>
        <div class="grupo-campo">
            <label>Teléfono de Contacto:</label>
            <input type="text" value="+502 7760-0000">
        </div>
    </div>

    <!-- TARJETA 2: SERVIDORES Y BACKEND -->
    <div class="formulario-datos">
        <h2><i class="fa-solid fa-server"></i> Conexiones y Microservicios</h2>
        <div class="grupo-campo">
            <label>Servidor de Base de Datos (SQL Server):</label>
            <input type="text" value="localhost\SQLEXPRESS">
        </div>
        <div class="grupo-campo">
            <label>Microservicio SMTP (Notificaciones a Tutores):</label>
            <input type="text" value="https://api.notificaciones-asilo.org/v1/send">
        </div>
        <button type="button" class="btn-guardar">
            <i class="fa-solid fa-sliders"></i> Guardar Configuración
        </button>
    </div>
