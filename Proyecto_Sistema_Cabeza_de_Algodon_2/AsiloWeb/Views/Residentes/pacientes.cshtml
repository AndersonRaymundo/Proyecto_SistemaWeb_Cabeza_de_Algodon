<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reportes - Asilo Cabeza de Algodón</title>
    <link rel="stylesheet" href="/CSS/dashboard.css"> 
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
   <header class="barra-superior">
    <div class="logo-top"></div>
    <div class="usuario-info">
        <button class="btn-notificacion" title="Notificaciones">
            <i class="fa-solid fa-bell"></i>
            <span class="badge-notificacion" id="contador-notificaciones">0</span>
        </button>
        
        <div class="perfil-usuario">
            <div class="contenedor-avatar">
                <div class="avatar" id="avatar-usuario">G</div>
                <span class="estado-activo" title="En línea"></span>
            </div>
            <div class="datos-usuario">
                <span class="nombre-usuario" id="nombre-usuario">Dr. Raymundo</span>
                <span class="rol-usuario" id="rol-usuario">Administrador</span>
            </div>
        </div>
    </div>
</header>
    
    <div class="menu-contenido">
    <nav class="menu-lateral">
        <a href="/Home/Index" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FARMACIA">
            <i class="fa-solid fa-house"></i> INICIO
        </a>
        
        <a href="/Residentes/Index" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO">
            <i class="fa-solid fa-hospital-user"></i> PACIENTES
        </a>
        
        <!-- Solicitudes y Citas -->
        <a href="/Citas/Index" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO">
            <i class="fa-solid fa-calendar-check"></i> SOLICITUDES Y CITAS
        </a>
        
        <a href="/Historial/Index" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR">
            <i class="fa-solid fa-notes-medical"></i> HISTORIAL MÉDICO
        </a>
        
        <a href="/Farmacia/Index" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,FARMACIA">
            <i class="fa-solid fa-vials"></i> LAB Y FARMACIA
        </a>
        
        <a href="/Reportes/reportes" class="opcion-menu activa" data-rol="ADMINISTRADOR,DOCTOR">
            <i class="fa-solid fa-chart-line"></i> REPORTES
        </a>

        <a href="/Caja/Index" class="opcion-menu" data-rol="ADMINISTRADOR">
            <i class="fa-solid fa-cash-register"></i> CAJA
        </a>
        
        <a href="/Configuracion/Index" class="opcion-menu" data-rol="ADMINISTRADOR">
            <i class="fa-solid fa-gear"></i> CONFIGURACIÓN
        </a>
        
        <!-- BOTÓN DE SALIR -->
        <a href="/Account/Login" class="opcion-menu opcion-salir" id="btn-cerrar-sesion" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FARMACIA">
            <i class="fa-solid fa-right-from-bracket"></i> CERRAR SESIÓN
        </a>
    </nav>
</div>
        
      <main class="area-trabajo">
            <h1><i class="fa-solid fa-chart-line"></i> Módulo de Reportes Estadísticos e Informes</h1>
            <p>Generación de documentos en formato PDF consumiendo microservicio desacoplado</p>
            <br>
            <div class="lista-reportes">
                
                <!-- TARJETA 1 -->
                <div class="tarjeta-reporte">
                    <h3><i class="fa-solid fa-file-pdf"></i> Análisis Médicos por Paciente</h3>
                    <p>Exporta la ficha médica, medicamentos y padecimientos del residente.</p>
                    <button class="btn-descarga" onclick="generarReportePDF('001', 'Análisis Médicos por Paciente', 'Ficha médica, medicamentos y padecimientos')">
                        <i class="fa-solid fa-download"></i> Exportar PDF
                    </button>
                </div>
                <br>
                
                <!-- TARJETA 2 -->
                <div class="tarjeta-reporte">
                    <h3><i class="fa-solid fa-file-pdf"></i> Reporte de Cobros y Donaciones</h3>
                    <p>Consolidado de entradas financieras, mensualidades y gastos del asilo.</p>
                    <button class="btn-descarga" onclick="generarReportePDF('002', 'Reporte de Cobros y Donaciones', 'Consolidado de entradas financieras y gastos')">
                        <i class="fa-solid fa-download"></i> Exportar PDF
                    </button>
                </div>
                <br>
                
                <!-- TARJETA 3 -->
                <div class="tarjeta-reporte">
                    <h3><i class="fa-solid fa-file-pdf"></i> Pagos Realizados a la Fundación</h3>
                    <p>Detalle de costos de consultas, exámenes y medicamentos con descuento.</p>
                    <button class="btn-descarga" onclick="generarReportePDF('003', 'Pagos Realizados a la Fundación', 'Detalle de consultas, exámenes y medicamentos')">
                        <i class="fa-solid fa-download"></i> Exportar PDF
                    </button>
                </div>

            </div>
        </main>
    </div>

    <!-- SCRIPT CONTROLADOR DE ROLES Y REPORTES -->
    <script src="/JS/roles.js"></script>
    <script src="/JS/reportes.js"></script>
</body>
</html>