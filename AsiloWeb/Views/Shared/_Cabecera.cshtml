@* Barra superior comun a todas las pantallas: usuario, rol y notificaciones (la llena roles.js). *@
<header class="barra-superior">
    <div class="logo-top"></div>
    <div class="usuario-info">
        <button class="btn-notificacion" title="Notificaciones">
            <i class="fa-solid fa-bell"></i>
            <span class="badge-notificacion" id="contador-notificaciones">0</span>
        </button>

        <div class="perfil-usuario">
            <div class="contenedor-avatar">
                <div class="avatar" id="avatar-usuario">G</div>
                <span class="estado-activo" title="En línea"></span>
            </div>
            <div class="datos-usuario">
                <span class="nombre-usuario" id="nombre-usuario">Dr. Raymundo</span>
                <span class="rol-usuario" id="rol-usuario">Administrador</span>
            </div>
        </div>
    </div>
</header>
