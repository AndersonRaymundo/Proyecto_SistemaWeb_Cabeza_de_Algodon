@model string
@* Menu lateral comun a todas las pantallas. El modelo es la opcion activa: inicio, pacientes, citas,
   historial, laboratorio, reportes, caja o configuracion. roles.js oculta las opciones segun el rol. *@
<nav class="menu-lateral">
    <a href="/Home/MENU" class="opcion-menu @(Model == "inicio" ? "activa" : "")" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FARMACIA,FUNDACION,LABORATORIO">
        <i class="fa-solid fa-house"></i> INICIO
    </a>
    <a href="/Residentes" class="opcion-menu @(Model == "pacientes" ? "activa" : "")" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO">
        <i class="fa-solid fa-hospital-user"></i> PACIENTES
    </a>
    <a href="/Citas" class="opcion-menu @(Model == "citas" ? "activa" : "")" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FUNDACION">
        <i class="fa-solid fa-calendar-check"></i> SOLICITUDES Y CITAS
    </a>
    <a href="/Historial" class="opcion-menu @(Model == "historial" ? "activa" : "")" data-rol="ADMINISTRADOR,DOCTOR">
        <i class="fa-solid fa-notes-medical"></i> HISTORIAL MÉDICO
    </a>
    <a href="/LaboratorioFarmacia" class="opcion-menu @(Model == "laboratorio" ? "activa" : "")" data-rol="ADMINISTRADOR,FARMACIA,LABORATORIO">
        <i class="fa-solid fa-vials"></i> LAB Y FARMACIA
    </a>
    <a href="/Reportes" class="opcion-menu @(Model == "reportes" ? "activa" : "")" data-rol="ADMINISTRADOR,DOCTOR">
        <i class="fa-solid fa-chart-line"></i> REPORTES
    </a>
    <a href="/Caja" class="opcion-menu @(Model == "caja" ? "activa" : "")" data-rol="ADMINISTRADOR">
        <i class="fa-solid fa-cash-register"></i> CAJA
    </a>
    <a href="/Paginas/Configuracion" class="opcion-menu @(Model == "configuracion" ? "activa" : "")" data-rol="ADMINISTRADOR">
        <i class="fa-solid fa-gear"></i> CONFIGURACIÓN
    </a>
    <!-- CERRAR SESIÓN -->
    <a href="/Auth/Login" class="opcion-menu opcion-salir" id="btn-cerrar-sesion" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FARMACIA,FUNDACION,LABORATORIO">
        <i class="fa-solid fa-right-from-bracket"></i> CERRAR SESIÓN
    </a>
</nav>
