<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitudes y Citas - Asilo Cabeza de Algodón</title>
    <link rel="stylesheet" href="~/CSS/dashboard.css" asp-append-version="true"> 
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true">
</head>
<body class="pagina-citas">
  @await Html.PartialAsync("_Cabecera")
    
  <!-- CONTENEDOR PRINCIPAL -->
<div class="menu-contenido">
    
    <!-- MENÚ LATERAL -->
    @await Html.PartialAsync("_MenuLateral", "citas")
        
        <main class="area-trabajo">
            <h1><i class="fa-solid fa-calendar-check"></i> Remisiones y Agenda de Citas</h1>
            <p>Solicitudes de evaluación médica, agenda de citas de la Fundación y registro de las visitas.</p>

            <div class="barra-herramientas">
                <div class="pestanas" id="filtro-estado" role="tablist" aria-label="Filtrar solicitudes por estado">
                    <button type="button" class="pestana activa" data-filtro="">Todas <span class="contador" data-cuenta="">0</span></button>
                    <button type="button" class="pestana" data-filtro="Pendiente">Pendientes <span class="contador" data-cuenta="Pendiente">0</span></button>
                    <button type="button" class="pestana" data-filtro="Agendada">Agendadas <span class="contador" data-cuenta="Agendada">0</span></button>
                    <button type="button" class="pestana" data-filtro="Atendida">Atendidas <span class="contador" data-cuenta="Atendida">0</span></button>
                    <button type="button" class="pestana" data-filtro="Cancelada">Canceladas <span class="contador" data-cuenta="Cancelada">0</span></button>
                </div>
                <span class="espacio"></span>
                <button type="button" class="btn-guardar" data-abrir="panel-solicitud">
                    <i class="fa-solid fa-file-circle-plus"></i> Nueva solicitud
                </button>
            </div>

            <div class="formulario-datos">
                <h2><i class="fa-solid fa-list"></i> Solicitudes y agenda</h2>
                <div id="contenedor-solicitudes">
                    <!-- Se llena dinámicamente mediante Fetch / AJAX -->
                </div>
            </div>
        </main>
    </div>

    <!-- VENTANA: Nueva solicitud de evaluación -->
    <div class="panel-fondo" id="panel-solicitud">
        <div class="panel" role="dialog" aria-modal="true">
            <div class="panel-cabecera">
                <h2><i class="fa-solid fa-file-circle-plus"></i> Nueva solicitud de evaluación</h2>
                <button type="button" class="panel-cerrar" data-cerrar aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="panel-cuerpo">
                <p>Al enviarla se avisa por correo al familiar del residente y la solicitud pasa a la agenda de la Fundación.</p>
                <form id="form-solicitud">
                    <div class="fila-2">
                        <div class="grupo-campo">
                            <label>Seleccionar residente:</label>
                            <select id="select-residente-solicitud" required>
                                <option value="">-- Cargar Pacientes desde BD --</option>
                            </select>
                        </div>
                        <div class="grupo-campo">
                            <label>Especialidad médica solicitada:</label>
                            <select id="especialidad-solicitada" required><option value="">-- Seleccionar --</option></select>
                        </div>
                    </div>
                    <div class="grupo-campo">
                        <label>Motivo de remisión:</label>
                        <textarea id="motivo-remision" rows="3" placeholder="Describa los síntomas o justificación de la consulta..." required></textarea>
                    </div>
                    <div class="grupo-campo">
                        <label>Enfermero(a) que acompañará al residente (opcional):</label>
                        <select id="enfermero-asignado"><option value="">-- Sin acompañante --</option></select>
                    </div>
                <div class="panel-pie">
                    <button type="button" class="btn-guardar btn-secundario" data-cerrar>Cancelar</button>
                    <button type="submit" class="btn-guardar"><i class="fa-solid fa-paper-plane"></i> Enviar solicitud a la Fundación</button>
                </div>
                </form>
            </div>
        </div>
    </div>

    <!-- SCRIPT CONTROLADOR DE ROLES -->
    <script src="~/JS/roles.js" asp-append-version="true"></script>
    <script src="~/JS/ui.js" asp-append-version="true"></script>
    <script src="~/JS/comunes.js" asp-append-version="true"></script>
    <script src="~/JS/solicitudes-citas.js" asp-append-version="true"></script>
</body>
</html>