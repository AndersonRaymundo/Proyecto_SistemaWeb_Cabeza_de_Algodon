<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Historial Médico - Asilo Cabeza de Algodón</title>
    <link rel="stylesheet" href="~/CSS/dashboard.css"> 
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
</head>
<body class="pagina-historial">
   <header class="barra-superior">
    <div class="logo-top"></div>
    <div class="usuario-info">
        <button class="btn-notificacion" title="Notificaciones">
            <i class="fa-solid fa-bell"></i>
            <span class="badge-notificacion" id="contador-notificaciones">0</span>
        </button>
        
        <div class="perfil-usuario">
            <div class="contenedor-avatar">
                <div class="avatar" id="avatar-usuario">G</div>
                <span class="estado-activo" title="En línea"></span>
            </div>
            <div class="datos-usuario">
                <span class="nombre-usuario" id="nombre-usuario">Dr. Raymundo</span>
                <span class="rol-usuario" id="rol-usuario">Administrador</span>
            </div>
        </div>
    </div>
</header>
    
   <!-- CONTENEDOR PRINCIPAL -->
<div class="menu-contenido">
    
    <!-- MENÚ LATERAL -->
    <nav class="menu-lateral">
        <a href="/Home/MENU" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FARMACIA,FUNDACION,LABORATORIO">
            <i class="fa-solid fa-house"></i> INICIO
        </a>
        <a href="/Residentes" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO">
            <i class="fa-solid fa-hospital-user"></i> PACIENTES
        </a>
        <a href="/Citas" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FUNDACION">
            <i class="fa-solid fa-calendar-check"></i> SOLICITUDES Y CITAS
        </a>
        <a href="/Historial" class="opcion-menu activa" data-rol="ADMINISTRADOR,DOCTOR">
            <i class="fa-solid fa-notes-medical"></i> HISTORIAL MÉDICO
        </a>
        <a href="/LaboratorioFarmacia" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,FARMACIA,LABORATORIO">
            <i class="fa-solid fa-vials"></i> LAB Y FARMACIA
        </a>
        <a href="/Reportes" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR">
            <i class="fa-solid fa-chart-line"></i> REPORTES
        </a>
        
        <!-- OPCIÓN ACTIVA -->
        <a href="/Caja" class="opcion-menu" data-rol="ADMINISTRADOR">
            <i class="fa-solid fa-cash-register"></i> CAJA
        </a>
        
        <a href="/Paginas/Configuracion" class="opcion-menu" data-rol="ADMINISTRADOR">
            <i class="fa-solid fa-gear"></i> CONFIGURACIÓN
        </a>

        <!-- CERRAR SESIÓN -->
        <a href="/Auth/Login" class="opcion-menu opcion-salir" id="btn-cerrar-sesion" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FARMACIA,FUNDACION,LABORATORIO">
            <i class="fa-solid fa-right-from-bracket"></i> CERRAR SESIÓN
        </a>
    </nav>
        
     <main class="area-trabajo">
            <h1><i class="fa-solid fa-notes-medical"></i> Ficha Médica e Historial Clínico</h1>
            <p>Consulta del expediente completo del residente y registro de nuevas evaluaciones médicas</p>

            <div class="formulario-datos">
                <h2><i class="fa-solid fa-folder-open"></i> Expediente del residente</h2>
                <div class="selector-residente">
                    <div class="grupo-campo">
                        <label>Seleccionar residente:</label>
                        <select id="select-paciente-historial" name="id_paciente" placeholder="Escriba el nombre o expediente..."></select>
                    </div>
                    <button type="button" class="btn-guardar" id="btnNuevaEvaluacion" data-abrir="panel-evaluacion" disabled>
                        <i class="fa-solid fa-file-medical"></i> Nueva evaluación
                    </button>
                </div>
            </div>

            <!-- Aquí se dibuja el expediente en pestañas: ficha base, consultas, exámenes y medicación -->
            <div id="contenedor-historial">
                <div class="formulario-datos"><p class="vacio">Seleccione un residente para consultar su expediente clínico.</p></div>
            </div>
        </main>
    </div>

    <!-- VENTANA: Nueva evaluación / ficha clínica del día -->
    <div class="panel-fondo" id="panel-evaluacion">
        <div class="panel ancho" role="dialog" aria-modal="true">
            <div class="panel-cabecera">
                <h2><i class="fa-solid fa-file-medical"></i> Nueva evaluación / ficha clínica del día</h2>
                <button type="button" class="panel-cerrar" data-cerrar aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="panel-cuerpo">
                <p>Se registra para el residente seleccionado. Los exámenes pasan a Laboratorio y el medicamento a Farmacia.</p>
                <form id="form-ficha-medica">
                    <div class="fila-2">
                        <div class="grupo-campo">
                            <label>Motivo de consulta / síntomas:</label>
                            <input type="text" id="motivo" name="motivo" required placeholder="Ingrese motivo...">
                        </div>
                        <div class="grupo-campo">
                            <label>Examen de laboratorio a solicitar (opcional):</label>
                            <input type="text" id="examen-solicitado" placeholder="Ej. Perfil lipídico">
                        </div>
                    </div>
                    <div class="grupo-campo">
                        <label>Diagnóstico médico:</label>
                        <textarea id="diagnostico" name="diagnostico" rows="3" required placeholder="Ingrese diagnóstico..."></textarea>
                    </div>
                    <div class="grupo-campo">
                        <label>Medicamento / tratamiento recetado (opcional):</label>
                        <textarea id="tratamiento" name="tratamiento" rows="2" placeholder="Ej. Losartán 50mg"></textarea>
                    </div>
                    <div class="fila-2">
                        <div class="grupo-campo">
                            <label>Cantidad:</label>
                            <input type="text" id="cantidad-medicamento" placeholder="Ej. 30 tabletas">
                        </div>
                        <div class="grupo-campo">
                            <label>Tiempo de aplicación:</label>
                            <input type="text" id="tiempo-aplicacion" placeholder="Ej. 1 cada 12 h por 30 días">
                        </div>
                    </div>
                    <div class="fila-2">
                        <div class="grupo-campo">
                            <label>Precio de la consulta, precio de lista (Q):</label>
                            <input type="number" step="0.01" min="0" id="precio-consulta" placeholder="0.00">
                            <small id="precio-final" style="color:#1e7e34;"></small>
                        </div>
                        <div class="grupo-campo">
                            <label>Observaciones adicionales:</label>
                            <input type="text" id="observaciones" name="observaciones" placeholder="Ingrese observaciones...">
                        </div>
                    </div>
                <div class="panel-pie">
                    <button type="button" class="btn-guardar btn-secundario" data-cerrar>Cancelar</button>
                    <button type="submit" class="btn-guardar"><i class="fa-solid fa-floppy-disk"></i> Registrar ficha clínica</button>
                </div>
                </form>
            </div>
        </div>
    </div>

    <!-- SCRIPT CONTROLADOR DE ROLES -->
    <script src="~/JS/roles.js"></script>
    <script src="~/JS/ui.js"></script>
    <script src="~/JS/historial-medico.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>

</body>
</html>