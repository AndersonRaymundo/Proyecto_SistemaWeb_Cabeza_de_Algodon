<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Historial Médico - Asilo Cabeza de Algodón</title>
    <link rel="stylesheet" href="~/CSS/dashboard.css" asp-append-version="true"> 
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true">
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
</head>
<body class="pagina-historial">
   @await Html.PartialAsync("_Cabecera")
    
   <!-- CONTENEDOR PRINCIPAL -->
<div class="menu-contenido">
    
    <!-- MENÚ LATERAL -->
    @await Html.PartialAsync("_MenuLateral", "historial")
        
     <main class="area-trabajo">
            <h1><i class="fa-solid fa-notes-medical"></i> Ficha Médica e Historial Clínico</h1>
            <p>Consulta del expediente completo del residente y registro de nuevas evaluaciones médicas</p>

            <div class="formulario-datos">
                <h2><i class="fa-solid fa-folder-open"></i> Expediente del residente</h2>
                <div class="selector-residente">
                    <div class="grupo-campo">
                        <label>Seleccionar residente:</label>
                        <select id="select-paciente-historial" name="id_paciente" placeholder="Escriba el nombre o expediente..."></select>
                    </div>
                    <button type="button" class="btn-guardar" id="btnNuevaEvaluacion" data-abrir="panel-evaluacion" disabled>
                        <i class="fa-solid fa-file-medical"></i> Nueva evaluación
                    </button>
                </div>
            </div>

            <!-- Aquí se dibuja el expediente en pestañas: ficha base, consultas, exámenes y medicación -->
            <div id="contenedor-historial">
                <div class="formulario-datos"><p class="vacio">Seleccione un residente para consultar su expediente clínico.</p></div>
            </div>
        </main>
    </div>

    <!-- VENTANA: Nueva evaluación / ficha clínica del día -->
    <div class="panel-fondo" id="panel-evaluacion">
        <div class="panel ancho" role="dialog" aria-modal="true">
            <div class="panel-cabecera">
                <h2><i class="fa-solid fa-file-medical"></i> Nueva evaluación / ficha clínica del día</h2>
                <button type="button" class="panel-cerrar" data-cerrar aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="panel-cuerpo">
                <p>Se registra para el residente seleccionado. Los exámenes pasan a Laboratorio y el medicamento a Farmacia.</p>
                <form id="form-ficha-medica">
                    <div class="grupo-campo">
                        <label>Motivo de consulta / síntomas:</label>
                        <input type="text" id="motivo" name="motivo" required placeholder="Ingrese motivo...">
                    </div>
                    <div class="grupo-campo">
                        <label>Diagnóstico médico:</label>
                        <textarea id="diagnostico" name="diagnostico" rows="3" required placeholder="Ingrese diagnóstico..."></textarea>
                    </div>
                    <div class="grupo-campo">
                        <label>Exámenes de laboratorio a solicitar (opcional):</label>
                        <div id="eval-examenes"></div>
                        <button type="button" class="btn-agregar" onclick="agregarExamen('eval-examenes')"><i class="fa-solid fa-plus"></i> Agregar examen</button>
                    </div>
                    <div class="grupo-campo">
                        <label>Medicamentos / tratamiento recetado (opcional):</label>
                        <div id="eval-medicamentos"></div>
                        <button type="button" class="btn-agregar" onclick="agregarMedicamento('eval-medicamentos')"><i class="fa-solid fa-plus"></i> Agregar medicamento</button>
                    </div>
                    <div class="fila-2">
                        <div class="grupo-campo">
                            <label>Precio de la consulta, precio de lista (Q):</label>
                            <input type="number" step="0.01" min="0" id="precio-consulta" placeholder="0.00">
                            <small id="precio-final" style="color:#1e7e34;"></small>
                        </div>
                        <div class="grupo-campo">
                            <label>Observaciones adicionales:</label>
                            <input type="text" id="observaciones" name="observaciones" placeholder="Ingrese observaciones...">
                        </div>
                    </div>
                <div class="panel-pie">
                    <button type="button" class="btn-guardar btn-secundario" data-cerrar>Cancelar</button>
                    <button type="submit" class="btn-guardar"><i class="fa-solid fa-floppy-disk"></i> Registrar ficha clínica</button>
                </div>
                </form>
            </div>
        </div>
    </div>

    <!-- SCRIPT CONTROLADOR DE ROLES -->
    <script src="~/JS/roles.js" asp-append-version="true"></script>
    <script src="~/JS/ui.js" asp-append-version="true"></script>
    <script src="~/JS/comunes.js" asp-append-version="true"></script>
    <script src="~/JS/historial-medico.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>

</body>
</html>