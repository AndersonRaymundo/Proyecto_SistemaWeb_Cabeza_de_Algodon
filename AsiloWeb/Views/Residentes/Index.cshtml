<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pacientes - Asilo Cabeza de Algodón</title>
    <link rel="stylesheet" href="/CSS/dashboard.css"> 
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
    <header class="barra-superior">
        <div class="logo-top"></div>
        <div class="usuario-info">
            <button class="btn-notificacion" title="Notificaciones">
                <i class="fa-solid fa-bell"></i>
                <span class="badge-notificacion" id="contador-notificaciones">0</span>
            </button>
            
            <div class="perfil-usuario">
                <div class="contenedor-avatar">
                    <div class="avatar" id="avatar-usuario">G</div>
                    <span class="estado-activo" title="En línea"></span>
                </div>
                <div class="datos-usuario">
                    <span class="nombre-usuario" id="nombre-usuario">Dr. Raymundo</span>
                    <span class="rol-usuario" id="rol-usuario">Administrador</span>
                </div>
            </div>
        </div>
    </header>
    
    <!-- CONTENEDOR PRINCIPAL -->
    <div class="menu-contenido">
        
        <!-- MENÚ LATERAL -->
        <nav class="menu-lateral">
            <a href="/Home/MENU" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FARMACIA">
                <i class="fa-solid fa-house"></i> INICIO
            </a>
            <a href="/Residentes" class="opcion-menu activa" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO">
                <i class="fa-solid fa-hospital-user"></i> PACIENTES
            </a>
            <a href="/Citas" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO">
                <i class="fa-solid fa-calendar-check"></i> SOLICITUDES Y CITAS
            </a>
            <a href="/Historial" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR">
                <i class="fa-solid fa-notes-medical"></i> HISTORIAL MÉDICO
            </a>
            <a href="/LaboratorioFarmacia" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,FARMACIA">
                <i class="fa-solid fa-vials"></i> LAB Y FARMACIA
            </a>
            <a href="/Reportes" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR">
                <i class="fa-solid fa-chart-line"></i> REPORTES
            </a>
            <a href="/Caja" class="opcion-menu" data-rol="ADMINISTRADOR">
                <i class="fa-solid fa-cash-register"></i> CAJA
            </a>
            <a href="/Paginas/Configuracion" class="opcion-menu" data-rol="ADMINISTRADOR">
                <i class="fa-solid fa-gear"></i> CONFIGURACIÓN
            </a>

            <!-- CERRAR SESIÓN -->
            <a href="/Auth/Login" class="opcion-menu opcion-salir" id="btn-cerrar-sesion" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FARMACIA">
                <i class="fa-solid fa-right-from-bracket"></i> CERRAR SESIÓN
            </a>
        </nav>
        
        <main class="area-trabajo">
            <h1><i class="fa-solid fa-hospital-user"></i> Módulo de Gestión de Pacientes / Residentes</h1>
            <p>Registro, edición y control de estado de los residentes del asilo</p>
            <br>

            <!-- FORMULARIO DE REGISTRO / EDICIÓN -->
            <div class="tarjeta-formulario" style="background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 25px;">
                <h2><i class="fa-solid fa-user-plus"></i> Registro de Residente</h2>
                <br>
                <form id="formResidente" onsubmit="guardarResidente(event)">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px;">
                        
                        <div>
                            <label for="txtExpediente"><strong>No. Expediente:</strong></label>
                            <input type="text" id="txtExpediente" class="form-control" placeholder="Ej. EXP-2026-01" required style="width: 100%; padding: 8px; margin-top: 5px;">
                        </div>

                        <div>
                            <label for="txtNombre"><strong>Nombre Completo:</strong></label>
                            <input type="text" id="txtNombre" class="form-control" placeholder="Nombre completo" required style="width: 100%; padding: 8px; margin-top: 5px;">
                        </div>

                        <div>
                            <label for="txtFechaNacimiento"><strong>Fecha de Nacimiento:</strong></label>
                            <input type="date" id="txtFechaNacimiento" class="form-control" required style="width: 100%; padding: 8px; margin-top: 5px;">
                        </div>

                        <div>
                            <label for="txtPatologia"><strong>Patología / Condición:</strong></label>
                            <input type="text" id="txtPatologia" class="form-control" placeholder="Padecimientos principales" style="width: 100%; padding: 8px; margin-top: 5px;">
                        </div>

                        <div>
                            <label for="txtTutor"><strong>Nombre del Tutor:</strong></label>
                            <input type="text" id="txtTutor" class="form-control" placeholder="Nombre de encargado" style="width: 100%; padding: 8px; margin-top: 5px;">
                        </div>

                        <div>
                            <label for="txtTelefono"><strong>Teléfono del Tutor:</strong></label>
                            <input type="tel" id="txtTelefono" class="form-control" placeholder="Teléfono de contacto" style="width: 100%; padding: 8px; margin-top: 5px;">
                        </div>

                        <div>
                            <label for="txtCorreo"><strong>Correo del Tutor:</strong></label>
                            <input type="email" id="txtCorreo" class="form-control" placeholder="correo@ejemplo.com" style="width: 100%; padding: 8px; margin-top: 5px;">
                        </div>

                    </div>

                    <div style="margin-top: 20px; text-align: right;">
                        <button type="submit" class="btn-guardar" style="background: #28a745; color: white; border: none; padding: 10px 20px; border-radius: 4px; font-weight: bold; cursor: pointer;">
                            <i class="fa-solid fa-floppy-disk"></i> Registrar Residente
                        </button>
                    </div>
                </form>
            </div>

            <!-- TABLA DE RESIDENTES -->
            <div class="tarjeta-tabla" style="background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <h2><i class="fa-solid fa-list"></i> Listado de Residentes</h2>
                <br>
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead>
                            <tr style="background-color: #f8f9fa; border-bottom: 2px solid #dee2e6;">
                                <th style="padding: 12px;">Expediente</th>
                                <th style="padding: 12px;">Nombre Completo</th>
                                <th style="padding: 12px;">Tutor</th>
                                <th style="padding: 12px;">Teléfono Tutor</th>
                                <th style="padding: 12px;">Estado</th>
                                <th style="padding: 12px; text-align: center;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tablaResidentesBody">
                            <!-- Los datos se cargan dinámicamente desde el JS -->
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

    <!-- MODAL PARA ENVIAR CORREO -->
    <div id="modalEmail" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 9999;">
        <div style="background: white; border-radius: 8px; padding: 25px; width: 90%; max-width: 500px; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <h3 style="margin-top: 0; color: #1a365d;"><i class="fa-solid fa-envelope"></i> Enviar Notificación al Tutor</h3>
            <hr style="border: 0; border-top: 1px solid #eee; margin: 15px 0;">
            
            <form id="formEnviarCorreo" onsubmit="enviarCorreoTutor(event)">
                <input type="hidden" id="emailResidenteNombre">
                
                <div style="margin-bottom: 12px;">
                    <label style="font-size: 0.9rem; font-weight: bold;">Destinatario:</label>
                    <input type="email" id="emailDestino" class="form-control" readonly style="width: 100%; padding: 8px; margin-top: 4px; background: #e9ecef;">
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="font-size: 0.9rem; font-weight: bold;">Motivo / Tipo de Notificación:</label>
                    <select id="emailTipo" class="form-control" style="width: 100%; padding: 8px; margin-top: 4px;" onchange="actualizarAsuntoPredeterminado()">
                        <option value="MEDICAMENTO">Notificación de Medicamento / Farmacia</option>
                        <option value="CITA">Recordatorio de Cita Médica</option>
                        <option value="ESTADO">Informativo de Estado de Salud</option>
                        <option value="GENERAL">Aviso General</option>
                    </select>
                </div>

                <div style="margin-bottom: 12px;">
                    <label style="font-size: 0.9rem; font-weight: bold;">Asunto:</label>
                    <input type="text" id="emailAsunto" class="form-control" required style="width: 100%; padding: 8px; margin-top: 4px;">
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="font-size: 0.9rem; font-weight: bold;">Mensaje:</label>
                    <textarea id="emailMensaje" rows="4" class="form-control" required placeholder="Escriba la información relevante para el tutor..." style="width: 100%; padding: 8px; margin-top: 4px; resize: vertical;"></textarea>
                </div>

                <div style="text-align: right;">
                    <button type="button" onclick="cerrarModalEmail()" style="background: #6c757d; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; margin-right: 8px;">
                        Cancelar
                    </button>
                    <button type="submit" id="btnEnviarEmailSubmit" style="background: #007bff; color: white; border: none; padding: 8px 16px; border-radius: 4px; font-weight: bold; cursor: pointer;">
                        <i class="fa-solid fa-paper-plane"></i> Enviar Correo
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="/JS/roles.js"></script>
    <script src="/JS/pacientes.js"></script>
</body>
</html>