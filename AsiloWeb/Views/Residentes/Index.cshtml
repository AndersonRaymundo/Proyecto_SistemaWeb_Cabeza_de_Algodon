<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pacientes - Asilo Cabeza de Algodón</title>
    <link rel="stylesheet" href="/CSS/dashboard.css"> 
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="pagina-pacientes">
    <header class="barra-superior">
        <div class="logo-top"></div>
        <div class="usuario-info">
            <button class="btn-notificacion" title="Notificaciones">
                <i class="fa-solid fa-bell"></i>
                <span class="badge-notificacion" id="contador-notificaciones">0</span>
            </button>
            
            <div class="perfil-usuario">
                <div class="contenedor-avatar">
                    <div class="avatar" id="avatar-usuario">G</div>
                    <span class="estado-activo" title="En línea"></span>
                </div>
                <div class="datos-usuario">
                    <span class="nombre-usuario" id="nombre-usuario">Dr. Raymundo</span>
                    <span class="rol-usuario" id="rol-usuario">Administrador</span>
                </div>
            </div>
        </div>
    </header>
    
    <!-- CONTENEDOR PRINCIPAL -->
    <div class="menu-contenido">
        
        <!-- MENÚ LATERAL -->
        <nav class="menu-lateral">
            <a href="/Home/MENU" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FARMACIA,FUNDACION,LABORATORIO">
                <i class="fa-solid fa-house"></i> INICIO
            </a>
            <a href="/Residentes" class="opcion-menu activa" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO">
                <i class="fa-solid fa-hospital-user"></i> PACIENTES
            </a>
            <a href="/Citas" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FUNDACION">
                <i class="fa-solid fa-calendar-check"></i> SOLICITUDES Y CITAS
            </a>
            <a href="/Historial" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR">
                <i class="fa-solid fa-notes-medical"></i> HISTORIAL MÉDICO
            </a>
            <a href="/LaboratorioFarmacia" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,FARMACIA,LABORATORIO">
                <i class="fa-solid fa-vials"></i> LAB Y FARMACIA
            </a>
            <a href="/Reportes" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR">
                <i class="fa-solid fa-chart-line"></i> REPORTES
            </a>
            <a href="/Caja" class="opcion-menu" data-rol="ADMINISTRADOR">
                <i class="fa-solid fa-cash-register"></i> CAJA
            </a>
            <a href="/Paginas/Configuracion" class="opcion-menu" data-rol="ADMINISTRADOR">
                <i class="fa-solid fa-gear"></i> CONFIGURACIÓN
            </a>

            <!-- CERRAR SESIÓN -->
            <a href="/Auth/Login" class="opcion-menu opcion-salir" id="btn-cerrar-sesion" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FARMACIA,FUNDACION,LABORATORIO">
                <i class="fa-solid fa-right-from-bracket"></i> CERRAR SESIÓN
            </a>
        </nav>
        
        <main class="area-trabajo">
            <h1><i class="fa-solid fa-hospital-user"></i> Gestión de Pacientes / Residentes</h1>
            <p>Consulta, registro y control de estado de los residentes del asilo</p>

            <!-- BARRA DE HERRAMIENTAS: buscador, filtro y botón de registro -->
            <div class="barra-herramientas">
                <div class="buscador">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="search" id="buscadorResidentes" placeholder="Buscar por nombre, expediente o tutor..." oninput="filtrarResidentes()">
                </div>
                <select id="filtroEstadoResidentes" onchange="filtrarResidentes()">
                    <option value="">Todos los estados</option>
                    <option value="activo">Activos</option>
                    <option value="inactivo">Inactivos</option>
                </select>
                <span class="conteo" id="conteoResidentes"></span>
                <span class="espacio"></span>
                <button type="button" class="btn-guardar" onclick="nuevoResidente()">
                    <i class="fa-solid fa-user-plus"></i> Nuevo residente
                </button>
            </div>

            <!-- LISTADO DE RESIDENTES -->
            <div class="formulario-datos sin-relleno">
                <div class="tabla-contenedor">
                    <table class="tabla-datos">
                        <thead>
                            <tr>
                                <th>Expediente</th>
                                <th>Nombre completo</th>
                                <th>Tutor</th>
                                <th>Teléfono tutor</th>
                                <th>Estado</th>
                                <th class="centrado">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tablaResidentesBody">
                            <!-- Los datos se cargan dinámicamente desde el JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- VENTANA: REGISTRO / EDICIÓN DE RESIDENTE -->
    <div class="panel-fondo" id="panel-residente">
        <div class="panel ancho" role="dialog" aria-modal="true">
            <div class="panel-cabecera">
                <h2><i class="fa-solid fa-user-plus"></i> <span id="tituloPanelResidente">Registrar residente</span></h2>
                <button type="button" class="panel-cerrar" onclick="cancelarEdicion()" aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="panel-cuerpo">
                <form id="formResidente" onsubmit="guardarResidente(event)">
                    <div class="fila-2">
                    <div class="grupo-campo">
                        <label for="txtExpediente">No. de expediente</label>
                        <input type="text" id="txtExpediente" placeholder="Ej. EXP-2026-01" required>
                    </div>
                    <div class="grupo-campo">
                        <label for="txtNombre">Nombre completo</label>
                        <input type="text" id="txtNombre" placeholder="Nombre completo del residente" required>
                    </div>
                    </div>
                    <div class="fila-2">
                    <div class="grupo-campo">
                        <label for="txtFechaNacimiento">Fecha de nacimiento</label>
                        <input type="date" id="txtFechaNacimiento" placeholder="" required>
                    </div>
                    <div class="grupo-campo">
                        <label for="txtPatologia">Patología / condición</label>
                        <input type="text" id="txtPatologia" placeholder="Padecimientos principales">
                    </div>
                    </div>
                    <div class="fila-3">
                    <div class="grupo-campo">
                        <label for="txtTutor">Nombre del tutor</label>
                        <input type="text" id="txtTutor" placeholder="Nombre del encargado">
                    </div>
                    <div class="grupo-campo">
                        <label for="txtTelefono">Teléfono del tutor</label>
                        <input type="tel" id="txtTelefono" placeholder="Teléfono de contacto">
                    </div>
                    <div class="grupo-campo">
                        <label for="txtCorreo">Correo del tutor</label>
                        <input type="email" id="txtCorreo" placeholder="correo@ejemplo.com">
                    </div>
                    </div>
                    <div class="grupo-campo">
                        <label for="txtMedicamentosCajon">Medicamentos de cajón (uso continuo)</label>
                        <input type="text" id="txtMedicamentosCajon" placeholder="Ej. Losartán 50mg, Metformina 850mg (se guardan en la ficha médica base)">
                    </div>
                    <div class="panel-pie">
                        <button type="button" class="btn-guardar btn-secundario" onclick="cancelarEdicion()">Cancelar</button>
                        <button type="submit" class="btn-guardar" id="btnGuardarResidente"><i class="fa-solid fa-floppy-disk"></i> Registrar residente</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- VENTANA: ENVIAR CORREO AL TUTOR (la abre/cierra pacientes.js) -->
    <div class="panel-fondo" id="modalEmail">
        <div class="panel" role="dialog" aria-modal="true">
            <div class="panel-cabecera">
                <h2><i class="fa-solid fa-envelope"></i> Enviar notificación al tutor</h2>
                <button type="button" class="panel-cerrar" onclick="cerrarModalEmail()" aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="panel-cuerpo">
                <form id="formEnviarCorreo" onsubmit="enviarCorreoTutor(event)">
                    <input type="hidden" id="emailResidenteNombre">
                    <div class="grupo-campo">
                        <label>Destinatario</label>
                        <input type="email" id="emailDestino" readonly>
                    </div>
                    <div class="grupo-campo">
                        <label>Motivo / tipo de notificación</label>
                        <select id="emailTipo" onchange="actualizarAsuntoPredeterminado()">
                            <option value="MEDICAMENTO">Notificación de medicamento / farmacia</option>
                            <option value="CITA">Recordatorio de cita médica</option>
                            <option value="ESTADO">Informativo de estado de salud</option>
                            <option value="GENERAL">Aviso general</option>
                        </select>
                    </div>
                    <div class="grupo-campo">
                        <label>Asunto</label>
                        <input type="text" id="emailAsunto" required>
                    </div>
                    <div class="grupo-campo">
                        <label>Mensaje</label>
                        <textarea id="emailMensaje" rows="4" required placeholder="Escriba la información relevante para el tutor..."></textarea>
                    </div>
                    <div class="panel-pie">
                        <button type="button" class="btn-guardar btn-secundario" onclick="cerrarModalEmail()">Cancelar</button>
                        <button type="submit" class="btn-guardar" id="btnEnviarEmailSubmit"><i class="fa-solid fa-paper-plane"></i> Enviar correo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="/JS/roles.js"></script>
    <script src="/JS/ui.js"></script>
    <script src="/JS/pacientes.js"></script>
</body>
</html>