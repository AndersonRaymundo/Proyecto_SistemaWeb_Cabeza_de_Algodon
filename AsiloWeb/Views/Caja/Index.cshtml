@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Caja - Asilo Cabeza de Algodón</title>
    <!-- CSS Unificado -->
    <link rel="stylesheet" href="~/CSS/dashboard.css">
    <!-- FontAwesome 6 Correcto -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
      <header class="barra-superior">
    <div class="logo-top"></div>
    <div class="usuario-info">
        <button class="btn-notificacion" title="Notificaciones">
            <i class="fa-solid fa-bell"></i>
            <span class="badge-notificacion" id="contador-notificaciones">0</span>
        </button>
        
        <div class="perfil-usuario">
            <div class="contenedor-avatar">
                <div class="avatar" id="avatar-usuario">G</div>
                <span class="estado-activo" title="En línea"></span>
            </div>
            <div class="datos-usuario">
                <span class="nombre-usuario" id="nombre-usuario">Dr. Raymundo</span>
                <span class="rol-usuario" id="rol-usuario">Administrador</span>
            </div>
        </div>
    </div>
</header>

   <!-- CONTENEDOR PRINCIPAL -->
<div class="menu-contenido">
    
    <!-- MENÚ LATERAL -->
    <nav class="menu-lateral">
        <a href="/Home/MENU" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FARMACIA">
            <i class="fa-solid fa-house"></i> INICIO
        </a>
        <a href="/Residentes" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO">
            <i class="fa-solid fa-hospital-user"></i> PACIENTES
        </a>
        <a href="/Citas" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO">
            <i class="fa-solid fa-calendar-check"></i> SOLICITUDES Y CITAS
        </a>
        <a href="/Historial" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR">
            <i class="fa-solid fa-notes-medical"></i> HISTORIAL MÉDICO
        </a>
        <a href="/LaboratorioFarmacia" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,FARMACIA">
            <i class="fa-solid fa-vials"></i> LAB Y FARMACIA
        </a>
        <a href="/Reportes" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR">
            <i class="fa-solid fa-chart-line"></i> REPORTES
        </a>
        
        <!-- OPCIÓN ACTIVA -->
        <a href="/Caja" class="opcion-menu activa" data-rol="ADMINISTRADOR">
            <i class="fa-solid fa-cash-register"></i> CAJA
        </a>
        
        <a href="/Paginas/Configuracion" class="opcion-menu" data-rol="ADMINISTRADOR">
            <i class="fa-solid fa-gear"></i> CONFIGURACIÓN
        </a>

        <!-- CERRAR SESIÓN -->
        <a href="/Auth/Login" class="opcion-menu opcion-salir" id="btn-cerrar-sesion" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FARMACIA">
            <i class="fa-solid fa-right-from-bracket"></i> CERRAR SESIÓN
        </a>
    </nav>

        <!-- ÁREA DE TRABAJO -->
        <main class="area-trabajo">
            <h1><i class="fa-solid fa-cash-register"></i> Módulo de Caja y Finanzas</h1>
            <p>Gestión de ingresos, mensualidades de residentes y comprobantes de pago.</p>

            <div class="formulario-datos">
                <h2><i class="fa-solid fa-receipt"></i> Registrar Movimiento de Cuentas</h2>
                <form id="form-cobro">
                    <div class="grupo-campo">
                        <label><i class="fa-solid fa-user"></i> Seleccionar Residente:</label>
                        <select id="select-residente-caja">
                            <option value="">-- Cargar Pacientes desde BD --</option>
                        </select>
                    </div>
                    <div class="grupo-campo">
                        <label><i class="fa-solid fa-tags"></i> Tipo de Cobro:</label>
                        <select id="tipo-cobro">
                            <option value="Mensualidad">Mensualidad</option>
                            <option value="Consulta">Consulta médica</option>
                            <option value="Laboratorio">Laboratorio</option>
                            <option value="Farmacia">Farmacia</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                    <div class="grupo-campo">
                        <label><i class="fa-solid fa-file-invoice"></i> Concepto / Detalle de Pago:</label>
                        <input type="text" id="concepto-cobro" placeholder="Ej. Cuota mensualidad - Septiembre">
                    </div>
                    <div class="grupo-campo">
                        <label><i class="fa-solid fa-money-bill-wave"></i> Monto Total (Q):</label>
                        <input type="number" step="0.01" id="monto-cobro" placeholder="0.00">
                    </div>
                    <button type="submit" class="btn-guardar">
                        <i class="fa-solid fa-floppy-disk"></i> Registrar Transacción
                    </button>
                </form>
            </div>

            <br>
            <div class="formulario-datos">
                <h2><i class="fa-solid fa-chart-pie"></i> Resumen Financiero</h2>
                <div id="contenedor-resumen-caja">
                    <!-- Se llena dinámicamente mediante Fetch / AJAX -->
                </div>
            </div>

            <br>
            <div class="formulario-datos">
                <h2><i class="fa-solid fa-list"></i> Cobros Registrados</h2>
                <div id="contenedor-cobros">
                    <!-- Se llena dinámicamente mediante Fetch / AJAX -->
                </div>
            </div>
        </main>

    </div>

    <!-- SCRIPT DE ROLES Y SESIÓN -->
    <script src="~/JS/roles.js"></script>
    <script src="~/JS/caja.js"></script>
</body>
</html>