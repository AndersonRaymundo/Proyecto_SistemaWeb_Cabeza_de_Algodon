<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laboratorio y Farmacia - Asilo Cabeza de Algodón</title>
    <link rel="stylesheet" href="~/CSS/dashboard.css"> 
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  
<header class="barra-superior">
    <div class="logo-top"></div>
    <div class="usuario-info">
        <button class="btn-notificacion" title="Notificaciones">
            <i class="fa-solid fa-bell"></i>
            <span class="badge-notificacion" id="contador-notificaciones">0</span>
        </button>
        
        <div class="perfil-usuario">
            <div class="contenedor-avatar">
                <div class="avatar" id="avatar-usuario">G</div>
                <span class="estado-activo" title="En línea"></span>
            </div>
            <div class="datos-usuario">
                <span class="nombre-usuario" id="nombre-usuario">Dr. Raymundo</span>
                <span class="rol-usuario" id="rol-usuario">Administrador</span>
            </div>
        </div>
    </div>
</header>

    <!-- CONTENEDOR PRINCIPAL -->
<div class="menu-contenido">
    
    <!-- MENÚ LATERAL -->
    <nav class="menu-lateral">
        <a href="/Home/MENU" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FARMACIA">
            <i class="fa-solid fa-house"></i> INICIO
        </a>
        <a href="/Residentes" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO">
            <i class="fa-solid fa-hospital-user"></i> PACIENTES
        </a>
        <a href="/Citas" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO">
            <i class="fa-solid fa-calendar-check"></i> SOLICITUDES Y CITAS
        </a>
        <a href="/Historial" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR">
            <i class="fa-solid fa-notes-medical"></i> HISTORIAL MÉDICO
        </a>
        <a href="/LaboratorioFarmacia" class="opcion-menu activa" data-rol="ADMINISTRADOR,DOCTOR,FARMACIA">
            <i class="fa-solid fa-vials"></i> LAB Y FARMACIA
        </a>
        <a href="/Reportes" class="opcion-menu" data-rol="ADMINISTRADOR,DOCTOR">
            <i class="fa-solid fa-chart-line"></i> REPORTES
        </a>
        
        <!-- OPCIÓN ACTIVA -->
        <a href="/Caja" class="opcion-menu" data-rol="ADMINISTRADOR">
            <i class="fa-solid fa-cash-register"></i> CAJA
        </a>
        
        <a href="/Paginas/Configuracion" class="opcion-menu" data-rol="ADMINISTRADOR">
            <i class="fa-solid fa-gear"></i> CONFIGURACIÓN
        </a>

        <!-- CERRAR SESIÓN -->
        <a href="/Auth/Login" class="opcion-menu opcion-salir" id="btn-cerrar-sesion" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FARMACIA">
            <i class="fa-solid fa-right-from-bracket"></i> CERRAR SESIÓN
        </a>
    </nav>
        
        <main class="area-trabajo">
            <h1><i class="fa-solid fa-vials"></i> Resultados de Laboratorio y Despacho de Farmacia</h1>
            <p>Registro de resultados de exámenes clínicos y cargos de medicamentos con tarifa preferencial</p>
            <br>
            
            <form class="formulario-datos" id="form-lab-farmacia">
                <h2><i class="fa-solid fa-microscope"></i> Exámenes de Laboratorio</h2>
                <br>
                <div class="grupo-campo">
                    <label>Seleccionar Residente:</label>
                    <select id="select-residente-lab" required>
                        <option value="">-- Cargar Pacientes desde la BD --</option>
                    </select>
                </div>
                <div class="grupo-campo">
                    <label>Nombre del Examen:</label>
                    <input type="text" id="nombre-examen" placeholder="Ej. Perfil Lipídico">
                </div>
                <div class="grupo-campo">
                    <label>Resultados del Análisis:</label>
                    <textarea id="resultados-examen" rows="3" placeholder="Ingrese el reporte de resultados del laboratorio..."></textarea>
                </div>
                <div class="grupo-campo">
                    <label>Costo del Examen con Descuento Fundación (Q):</label>
                    <input type="number" step="0.01" id="costo-examen" placeholder="150.00">
                </div>
                
                <hr style="margin: 20px 0; border: 0; border-top: 1px solid #ccc;">
                
                <h2><i class="fa-solid fa-pills"></i> Receta y Medicamentos</h2>
                <br>
                <div class="grupo-campo">
                    <label>Medicamento Recetado / Cajón:</label>
                    <input type="text" id="medicamento" placeholder="Ej. Losartán 50mg / Metformina 850mg">
                </div>
                <div class="grupo-campo">
                    <label>Instrucciones de Dosis:</label>
                    <input type="text" id="dosis-instrucciones" placeholder="Ej. 1 tableta cada 12 horas por 30 días">
                </div>
                <div class="grupo-campo">
                    <label>Cantidad:</label>
                    <input type="text" id="cantidad-medicamento" placeholder="Ej. 30 tabletas">
                </div>
                <div class="grupo-campo">
                    <label>Costo Medicamento Carga Familiar (Q):</label>
                    <input type="number" step="0.01" id="costo-medicamento" placeholder="85.00">
                </div>
                
                <button type="submit" class="btn-guardar"><i class="fa-solid fa-floppy-disk"></i> Registrar Examen y Farmacia</button>
            </form>

            <br>
            <div class="formulario-datos">
                <h2><i class="fa-solid fa-list"></i> Últimos Exámenes y Recetas Registrados</h2>
                <div id="contenedor-lab-farmacia">
                    <!-- Se llena dinámicamente mediante Fetch / AJAX -->
                </div>
            </div>
        </main>
    </div>
    <!-- SCRIPT CONTROLADOR DE ROLES -->
    <script src="~/JS/roles.js"></script>
    <script src="~/JS/laboratorio-farmacia.js"></script>
</body>
</html>