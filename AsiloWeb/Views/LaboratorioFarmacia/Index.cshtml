<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laboratorio y Farmacia - Asilo Cabeza de Algodón</title>
    <link rel="stylesheet" href="~/CSS/dashboard.css" asp-append-version="true"> 
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true">
</head>
<body class="pagina-laboratorio">
  
@await Html.PartialAsync("_Cabecera")

    <!-- CONTENEDOR PRINCIPAL -->
<div class="menu-contenido">
    
    <!-- MENÚ LATERAL -->
    @await Html.PartialAsync("_MenuLateral", "laboratorio")
        
        <main class="area-trabajo">
            <h1><i class="fa-solid fa-vials"></i> Laboratorio y Farmacia</h1>
            <p id="nota-descuento">Los exámenes y medicamentos recetados en una visita médica llegan aquí; al completarlos se cargan a la cuenta del familiar.</p>

            <div class="pestanas">
                <button type="button" class="pestana activa" id="tab-btn-lab" data-pestana="seccion-laboratorio">
                    <i class="fa-solid fa-microscope"></i> Laboratorio <span class="contador" id="contador-examenes">0</span>
                </button>
                <button type="button" class="pestana" id="tab-btn-farmacia" data-pestana="seccion-farmacia">
                    <i class="fa-solid fa-pills"></i> Farmacia <span class="contador" id="contador-medicamentos">0</span>
                </button>
                <button type="button" class="pestana" id="tab-btn-inventario" data-pestana="seccion-inventario">
                    <i class="fa-solid fa-boxes-stacked"></i> Inventario <span class="contador" id="contador-inventario">0</span>
                </button>
            </div>

            <!-- ======================== PESTAÑA LABORATORIO ======================== -->
            <section id="seccion-laboratorio" class="pestana-contenido activa">
                <div class="barra-herramientas">
                    <span class="espacio"></span>
                    <button type="button" class="btn-guardar" data-abrir="panel-examen">
                        <i class="fa-solid fa-flask"></i> Registrar examen directo
                    </button>
                </div>
                <div class="formulario-datos">
                    <h2><i class="fa-solid fa-hourglass-half"></i> Exámenes pendientes de resultado</h2>
                    <div id="contenedor-examenes-pendientes"></div>
                </div>
                <div class="formulario-datos">
                    <h2><i class="fa-solid fa-list-check"></i> Exámenes con resultado</h2>
                    <div id="contenedor-examenes"></div>
                </div>
            </section>

            <!-- ======================== PESTAÑA FARMACIA ======================== -->
            <section id="seccion-farmacia" class="pestana-contenido">
                <div class="barra-herramientas">
                    <span class="espacio"></span>
                    <button type="button" class="btn-guardar" data-abrir="panel-medicamento">
                        <i class="fa-solid fa-prescription-bottle-medical"></i> Registrar despacho directo
                    </button>
                </div>
                <div class="formulario-datos">
                    <h2><i class="fa-solid fa-hourglass-half"></i> Medicamentos pendientes de despacho</h2>
                    <div id="contenedor-medicamentos-pendientes"></div>
                </div>
                <div class="formulario-datos">
                    <h2><i class="fa-solid fa-list-check"></i> Despachos realizados</h2>
                    <div id="contenedor-medicamentos"></div>
                </div>
            </section>
        
            <!-- ================= INVENTARIO ================= -->
            <section id="seccion-inventario" class="pestana-contenido">
                <div class="barra-herramientas">
                    <span class="espacio"></span>
                    <button type="button" class="btn-guardar" onclick="nuevoInventario()">
                        <i class="fa-solid fa-plus"></i> Nuevo medicamento
                    </button>
                </div>
                <div class="formulario-datos">
                    <h2><i class="fa-solid fa-boxes-stacked"></i> Inventario de medicamentos</h2>
                    <p style="color:#64748b; font-size:.88rem;">El contador de la pestaña indica cuántos productos necesitan atención: existencias bajas, agotados, por vencer o vencidos. Al despachar un medicamento elegido de aquí, las unidades se descuentan solas.</p>
                    <div id="contenedor-inventario"></div>
                </div>
            </section>
        </main>
    </div>

    <!-- VENTANA: Registrar examen directo -->
    <div class="panel-fondo" id="panel-examen">
        <div class="panel" role="dialog" aria-modal="true">
            <div class="panel-cabecera">
                <h2><i class="fa-solid fa-flask"></i> Registrar examen directo</h2>
                <button type="button" class="panel-cerrar" data-cerrar aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="panel-cuerpo">
                <p>Para pacientes que llegan al laboratorio sin una visita previa. El costo se carga a la cuenta del familiar.</p>
                <form id="form-examen-directo">
                    <div class="fila-2">
                        <div class="grupo-campo">
                            <label>Residente:</label>
                            <select id="select-residente-examen" required><option value="">-- Cargar Pacientes desde la BD --</option></select>
                        </div>
                        <div class="grupo-campo">
                            <label>Nombre del examen:</label>
                            <input type="text" id="nombre-examen" required placeholder="Ej. Perfil lipídico">
                        </div>
                    </div>
                    <div class="grupo-campo">
                        <label>Resultados (opcional):</label>
                        <textarea id="resultados-examen" rows="3" placeholder="Reporte de resultados del laboratorio..."></textarea>
                    </div>
                    <div class="grupo-campo">
                        <label>Precio de lista del examen (Q):</label>
                        <input type="number" step="0.01" min="0" id="precio-examen" placeholder="0.00">
                        <small id="final-examen" style="color:#1e7e34;"></small>
                    </div>
                    <div class="panel-pie">
                        <button type="button" class="btn-guardar btn-secundario" data-cerrar>Cancelar</button>
                        <button type="submit" class="btn-guardar"><i class="fa-solid fa-floppy-disk"></i> Registrar examen</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- VENTANA: Registrar despacho directo -->
    <div class="panel-fondo" id="panel-medicamento">
        <div class="panel" role="dialog" aria-modal="true">
            <div class="panel-cabecera">
                <h2><i class="fa-solid fa-prescription-bottle-medical"></i> Registrar despacho directo</h2>
                <button type="button" class="panel-cerrar" data-cerrar aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="panel-cuerpo">
                <p>Para medicamentos entregados sin una receta previa en el sistema. El costo se carga a la cuenta del familiar.</p>
                <form id="form-medicamento-directo">
                    <div class="fila-2">
                        <div class="grupo-campo">
                            <label>Residente:</label>
                            <select id="select-residente-medicamento" required><option value="">-- Cargar Pacientes desde la BD --</option></select>
                        </div>
                        <div class="grupo-campo">
                            <label>Medicamento:</label>
                            <input type="text" id="nombre-medicamento" required placeholder="Ej. Losartán 50mg">
                        </div>
                    </div>
                    <div class="fila-2">
                        <div class="grupo-campo">
                            <label>Cantidad:</label>
                            <input type="text" id="cantidad-medicamento" placeholder="Ej. 30 tabletas">
                        </div>
                        <div class="grupo-campo">
                            <label>Tiempo de aplicación:</label>
                            <input type="text" id="tiempo-medicamento" placeholder="Ej. 1 cada 12 h por 30 días">
                        </div>
                    </div>
                    <div class="fila-2">
                        <div class="grupo-campo">
                            <label>Del inventario (opcional):</label>
                            <select id="inv-medicamento-directo"><option value="">Sin control de inventario</option></select>
                        </div>
                        <div class="grupo-campo">
                            <label>Unidades a descontar:</label>
                            <input type="number" min="1" step="1" id="unidades-medicamento" placeholder="Ej. 30">
                        </div>
                    </div>
                    <div class="grupo-campo">
                        <label>Precio de lista del medicamento (Q):</label>
                        <input type="number" step="0.01" min="0" id="precio-medicamento" placeholder="0.00">
                        <small id="final-medicamento" style="color:#1e7e34;"></small>
                    </div>
                    <div class="panel-pie">
                        <button type="button" class="btn-guardar btn-secundario" data-cerrar>Cancelar</button>
                        <button type="submit" class="btn-guardar"><i class="fa-solid fa-floppy-disk"></i> Registrar despacho</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- SCRIPT CONTROLADOR DE ROLES -->
    <!-- VENTANA: MEDICAMENTO DEL INVENTARIO (nuevo o editar) -->
    <div class="panel-fondo" id="panel-inventario">
        <div class="panel" role="dialog" aria-modal="true">
            <div class="panel-cabecera">
                <h2 id="titulo-inventario"><i class="fa-solid fa-boxes-stacked"></i> Nuevo medicamento</h2>
                <button type="button" class="panel-cerrar" data-cerrar aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="panel-cuerpo">
                <form id="form-inventario">
                    <input type="hidden" id="inv-id">
                    <div class="fila-2">
                        <div class="grupo-campo"><label>Medicamento:</label>
                            <input type="text" id="inv-nombre" required placeholder="Ej. Losartán 50 mg"></div>
                        <div class="grupo-campo"><label>Presentación:</label>
                            <input type="text" id="inv-presentacion" placeholder="Ej. Caja de 30 tabletas"></div>
                    </div>
                    <div class="fila-2">
                        <div class="grupo-campo"><label>Precio por unidad (Q):</label>
                            <input type="number" step="0.01" min="0" id="inv-precio" required placeholder="0.00"></div>
                        <div class="grupo-campo"><label>Existencias (unidades):</label>
                            <input type="number" step="1" min="0" id="inv-existencias" required placeholder="0"></div>
                    </div>
                    <div class="fila-2">
                        <div class="grupo-campo"><label>Avisar cuando queden (unidades):</label>
                            <input type="number" step="1" min="0" id="inv-minimo" required placeholder="0"></div>
                        <div class="grupo-campo"><label>Fecha de vencimiento (opcional):</label>
                            <input type="date" id="inv-vence"></div>
                    </div>
                    <div class="panel-pie">
                        <button type="button" class="btn-guardar btn-secundario" data-cerrar>Cancelar</button>
                        <button type="submit" class="btn-guardar"><i class="fa-solid fa-floppy-disk"></i> Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- VENTANA: ENTRADA DE EXISTENCIAS (compra o donación) -->
    <div class="panel-fondo" id="panel-entrada">
        <div class="panel" role="dialog" aria-modal="true">
            <div class="panel-cabecera">
                <h2><i class="fa-solid fa-truck-ramp-box"></i> Registrar entrada</h2>
                <button type="button" class="panel-cerrar" data-cerrar aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="panel-cuerpo">
                <form id="form-entrada">
                    <input type="hidden" id="entrada-id">
                    <p id="entrada-nombre"></p>
                    <div class="grupo-campo"><label>Unidades que ingresan:</label>
                        <input type="number" step="1" min="1" id="entrada-cantidad" required placeholder="Ej. 100"></div>
                    <div class="panel-pie">
                        <button type="button" class="btn-guardar btn-secundario" data-cerrar>Cancelar</button>
                        <button type="submit" class="btn-guardar"><i class="fa-solid fa-floppy-disk"></i> Registrar entrada</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/JS/roles.js" asp-append-version="true"></script>
    <script src="~/JS/ui.js" asp-append-version="true"></script>
    <script src="~/JS/comunes.js" asp-append-version="true"></script>
    <script src="~/JS/laboratorio-farmacia.js" asp-append-version="true"></script>
</body>
</html>