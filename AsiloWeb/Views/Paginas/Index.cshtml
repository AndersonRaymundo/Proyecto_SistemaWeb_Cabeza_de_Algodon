<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configuración - Asilo Cabeza de Algodón</title>
    <link rel="stylesheet" href="~/CSS/dashboard.css" asp-append-version="true"> 
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true">
</head>
<body class="pagina-configuracion">
 @await Html.PartialAsync("_Cabecera")
    
<!-- CONTENEDOR PRINCIPAL -->
<div class="menu-contenido">
    
    <!-- MENÚ LATERAL -->
    @await Html.PartialAsync("_MenuLateral", "configuracion")

      <main class="area-trabajo">
        <h1><i class="fa-solid fa-gear"></i> Configuración del Sistema</h1>
        <p>Cuentas de usuario, correos enviados y parámetros del sistema.</p>

        <div class="pestanas">
            <button type="button" class="pestana activa" data-pestana="pestana-usuarios"><i class="fa-solid fa-users-gear"></i> Usuarios</button>
            <button type="button" class="pestana" data-pestana="pestana-correos"><i class="fa-solid fa-envelope-circle-check"></i> Correos enviados</button>
            <button type="button" class="pestana" data-pestana="pestana-parametros"><i class="fa-solid fa-sliders"></i> Parámetros</button>
        </div>

        <div id="pestana-usuarios" class="pestana-contenido activa">
        <div class="formulario-datos" id="seccion-usuarios">
            <div class="barra-herramientas">
                <h2 style="margin:0;"><i class="fa-solid fa-users-gear"></i> Usuarios del sistema</h2>
                <span class="espacio"></span>
                <button type="button" class="btn-guardar" data-abrir="panel-usuario"><i class="fa-solid fa-user-plus"></i> Nuevo usuario</button>
            </div>
            <p style="color:#64748b; font-size:.88rem;">Cuentas de acceso al sistema: crear usuarios, asignar especialidades, cambiar contraseñas y correos, y desbloquear cuentas.</p>
            <div id="contenedor-usuarios"></div>
        </div>

        <!-- BITACORA DE CORREOS (solo el administrador) -->
        </div>

        <div id="pestana-correos" class="pestana-contenido">
        <div class="formulario-datos" id="seccion-bitacora">
            <div class="barra-herramientas">
                <h2 style="margin:0;"><i class="fa-solid fa-envelope-circle-check"></i> Correos enviados</h2>
                <span class="espacio"></span>
                <button type="button" class="btn-guardar btn-secundario" onclick="cargarBitacora()"><i class="fa-solid fa-rotate"></i> Actualizar</button>
            </div>
            <p style="color:#64748b; font-size:.88rem;">Registro de los últimos 50 correos del sistema (solicitudes, citas, comprobantes y códigos de recuperación) y si se enviaron.</p>
            <div id="contenedor-bitacora"></div>
        </div>
        </div>

        <div id="pestana-parametros" class="pestana-contenido">
        <div class="formulario-datos">
            <h2><i class="fa-solid fa-building"></i> Institución</h2>
            <div class="dato-clinico"><span>Nombre</span><span>Asilo de Ancianos Cabeza de Algodón</span></div>
            <div class="dato-clinico"><span>Sistema</span><span>Sistema de Administración del Asilo</span></div>
        </div>

        <div class="formulario-datos">
            <h2><i class="fa-solid fa-sliders"></i> Parámetros vigentes</h2>
            <div class="dato-clinico"><span>Descuento de la fundación sobre los costos médicos</span><span id="valor-descuento">Cargando...</span></div>
            <div class="dato-clinico"><span>Usuario conectado</span><span id="valor-usuario">—</span></div>
            <div class="dato-clinico"><span>Rol</span><span id="valor-rol">—</span></div>
            <p style="color:#64748b; font-size:.88rem; margin-top:10px;">El porcentaje de descuento lo define quien administra el servidor.</p>
        </div>

        <!-- USUARIOS DEL SISTEMA (solo el administrador) -->
        </div>
    </main>
    </div>
    <!-- VENTANA: NUEVO USUARIO -->
    <div class="panel-fondo" id="panel-usuario">
        <div class="panel" role="dialog" aria-modal="true">
            <div class="panel-cabecera">
                <h2><i class="fa-solid fa-user-plus"></i> Nuevo usuario</h2>
                <button type="button" class="panel-cerrar" data-cerrar aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="panel-cuerpo">
                <form id="form-usuario">
                    <div class="grupo-campo"><label>Nombre completo:</label>
                        <input type="text" id="usuario-nombre" required placeholder="Ej. Licda. Sofía López"></div>
                    <div class="fila-2">
                        <div class="grupo-campo"><label>Nombre de usuario:</label>
                            <input type="text" id="usuario-login" required placeholder="Ej. slopez" autocomplete="off"></div>
                        <div class="grupo-campo"><label>Rol:</label>
                            <select id="usuario-rol" required>
                                <option value="">-- Seleccionar --</option>
                                <option value="ADMINISTRADOR">Administrador</option>
                                <option value="DOCTOR">Doctor</option>
                                <option value="ENFERMERO">Enfermero</option>
                                <option value="FARMACIA">Farmacia</option>
                                <option value="FUNDACION">Fundación</option>
                                <option value="LABORATORIO">Laboratorio</option>
                            </select></div>
                    </div>
                    <div class="grupo-campo" id="grupo-especialidad" style="display:none;"><label>Especialidad del médico:</label>
                        <select id="usuario-especialidad"><option value="">-- Seleccionar --</option></select></div>
                    <div class="grupo-campo"><label>Correo (para recuperar la contraseña):</label>
                        <input type="email" id="usuario-correo" placeholder="correo@ejemplo.com"></div>
                    <div class="fila-2">
                        <div class="grupo-campo"><label>Contraseña:</label>
                            <input type="password" id="usuario-clave" required autocomplete="new-password"></div>
                        <div class="grupo-campo"><label>Repetir contraseña:</label>
                            <input type="password" id="usuario-clave2" required autocomplete="new-password"></div>
                    </div>
                    <p style="color:#64748b; font-size:.85rem; margin:0 0 10px;">La contraseña lleva al menos 8 caracteres, con letras y números.</p>
                    <div class="panel-pie">
                        <button type="button" class="btn-guardar btn-secundario" data-cerrar>Cancelar</button>
                        <button type="submit" class="btn-guardar"><i class="fa-solid fa-floppy-disk"></i> Crear usuario</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- VENTANA: NUEVA CONTRASEÑA DE UN USUARIO -->
    <div class="panel-fondo" id="panel-clave-usuario">
        <div class="panel" role="dialog" aria-modal="true">
            <div class="panel-cabecera">
                <h2><i class="fa-solid fa-key"></i> Nueva contraseña</h2>
                <button type="button" class="panel-cerrar" data-cerrar aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="panel-cuerpo">
                <form id="form-clave-usuario">
                    <p id="clave-usuario-nombre"></p>
                    <input type="hidden" id="clave-usuario-id">
                    <div class="fila-2">
                        <div class="grupo-campo"><label>Contraseña nueva:</label>
                            <input type="password" id="clave-nueva" required autocomplete="new-password"></div>
                        <div class="grupo-campo"><label>Repetir contraseña:</label>
                            <input type="password" id="clave-nueva2" required autocomplete="new-password"></div>
                    </div>
                    <p style="color:#64748b; font-size:.85rem; margin:0 0 10px;">Al guardarla, la cuenta también se desbloquea.</p>
                    <div class="panel-pie">
                        <button type="button" class="btn-guardar btn-secundario" data-cerrar>Cancelar</button>
                        <button type="submit" class="btn-guardar"><i class="fa-solid fa-floppy-disk"></i> Guardar contraseña</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- VENTANA: EDITAR LOS DATOS DE UN USUARIO (nombre y rol) -->
    <div class="panel-fondo" id="panel-datos-usuario">
        <div class="panel" role="dialog" aria-modal="true">
            <div class="panel-cabecera">
                <h2><i class="fa-solid fa-user-pen"></i> Editar usuario</h2>
                <button type="button" class="panel-cerrar" data-cerrar aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="panel-cuerpo">
                <form id="form-datos-usuario">
                    <p id="datos-usuario-login"></p>
                    <input type="hidden" id="datos-usuario-id">
                    <div class="grupo-campo"><label>Nombre completo:</label>
                        <input type="text" id="datos-usuario-nombre" maxlength="100" required></div>
                    <div class="grupo-campo"><label>Rol:</label>
                        <select id="datos-usuario-rol" required>
                            <option value="ADMINISTRADOR">Administrador</option>
                            <option value="DOCTOR">Doctor</option>
                            <option value="ENFERMERO">Enfermero</option>
                            <option value="FARMACIA">Farmacia</option>
                            <option value="FUNDACION">Fundación</option>
                            <option value="LABORATORIO">Laboratorio</option>
                        </select></div>
                    <div class="grupo-campo" id="datos-grupo-especialidad" style="display:none;"><label>Especialidad del médico:</label>
                        <select id="datos-usuario-especialidad"><option value="">-- Seleccionar --</option></select></div>
                    <p style="color:#64748b; font-size:.85rem;">El nombre de usuario no se puede cambiar. Si cambia el rol, la persona tendrá que volver a iniciar sesión.</p>
                    <div class="panel-pie">
                        <button type="button" class="btn-guardar btn-secundario" data-cerrar>Cancelar</button>
                        <button type="submit" class="btn-guardar"><i class="fa-solid fa-floppy-disk"></i> Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- VENTANA: ESPECIALIDAD DE UN MEDICO -->
    <div class="panel-fondo" id="panel-especialidad-usuario">
        <div class="panel" role="dialog" aria-modal="true">
            <div class="panel-cabecera">
                <h2><i class="fa-solid fa-stethoscope"></i> Especialidad del médico</h2>
                <button type="button" class="panel-cerrar" data-cerrar aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="panel-cuerpo">
                <form id="form-especialidad-usuario">
                    <p id="especialidad-usuario-nombre"></p>
                    <input type="hidden" id="especialidad-usuario-id">
                    <div class="grupo-campo"><label>Especialidad:</label>
                        <select id="especialidad-nueva" required><option value="">-- Seleccionar --</option></select></div>
                    <div class="panel-pie">
                        <button type="button" class="btn-guardar btn-secundario" data-cerrar>Cancelar</button>
                        <button type="submit" class="btn-guardar"><i class="fa-solid fa-floppy-disk"></i> Guardar especialidad</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- VENTANA: CORREO DE UN USUARIO -->
    <div class="panel-fondo" id="panel-correo-usuario">
        <div class="panel" role="dialog" aria-modal="true">
            <div class="panel-cabecera">
                <h2><i class="fa-solid fa-envelope"></i> Correo del usuario</h2>
                <button type="button" class="panel-cerrar" data-cerrar aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="panel-cuerpo">
                <form id="form-correo-usuario">
                    <p id="correo-usuario-nombre"></p>
                    <input type="hidden" id="correo-usuario-id">
                    <div class="grupo-campo"><label>Correo:</label>
                        <input type="email" id="correo-nuevo" required placeholder="correo@ejemplo.com"></div>
                    <div class="panel-pie">
                        <button type="button" class="btn-guardar btn-secundario" data-cerrar>Cancelar</button>
                        <button type="submit" class="btn-guardar"><i class="fa-solid fa-floppy-disk"></i> Guardar correo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- SCRIPT CONTROLADOR DE ROLES -->
    <script src="~/JS/roles.js" asp-append-version="true"></script><!-- SCRIPT CONTROLADOR DE ROLES -->
    <script src="~/JS/ui.js" asp-append-version="true"></script>
    <script src="~/JS/comunes.js" asp-append-version="true"></script>
    <script src="~/JS/configuracion.js" asp-append-version="true"></script>
    
</body>
</html>