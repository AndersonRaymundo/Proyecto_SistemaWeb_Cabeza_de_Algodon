<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configuración - Asilo Cabeza de Algodón</title>
    <link rel="stylesheet" href="~/CSS/dashboard.css" asp-append-version="true"> 
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true">
</head>
<body class="pagina-configuracion">
 @await Html.PartialAsync("_Cabecera")
    
<!-- CONTENEDOR PRINCIPAL -->
<div class="menu-contenido">
    
    <!-- MENÚ LATERAL -->
    @await Html.PartialAsync("_MenuLateral", "configuracion")

      <main class="area-trabajo">
        <h1><i class="fa-solid fa-gear"></i> Configuración del Sistema</h1>
        <p>Parámetros vigentes del sistema. Esta pantalla es de solo lectura.</p>

        <div class="formulario-datos">
            <h2><i class="fa-solid fa-building"></i> Institución</h2>
            <div class="dato-clinico"><span>Nombre</span><span>Asilo de Ancianos Cabeza de Algodón</span></div>
            <div class="dato-clinico"><span>Sistema</span><span>Sistema de Administración del Asilo</span></div>
        </div>

        <div class="formulario-datos">
            <h2><i class="fa-solid fa-sliders"></i> Parámetros vigentes</h2>
            <div class="dato-clinico"><span>Descuento de la fundación sobre los costos médicos</span><span id="valor-descuento">Cargando...</span></div>
            <div class="dato-clinico"><span>Usuario conectado</span><span id="valor-usuario">—</span></div>
            <div class="dato-clinico"><span>Rol</span><span id="valor-rol">—</span></div>
            <p style="color:#64748b; font-size:.88rem; margin-top:10px;">El porcentaje de descuento se define en la configuración del servidor (Fundacion:DescuentoPorcentaje).</p>
        </div>
    </main>
    </div>
    <!-- SCRIPT CONTROLADOR DE ROLES -->
    <script src="~/JS/roles.js" asp-append-version="true"></script><!-- SCRIPT CONTROLADOR DE ROLES -->
    <script src="~/JS/configuracion.js" asp-append-version="true"></script>
    
</body>
</html>