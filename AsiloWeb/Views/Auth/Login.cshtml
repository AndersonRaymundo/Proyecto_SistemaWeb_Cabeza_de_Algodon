<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Inicio de Sesión</title>
        <link rel="stylesheet" href="~/CSS/estilos.css" asp-append-version="true">
        <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true">
    </head>
<body>
    <div class="login">   
    <img src="~/imagen sesion/logo.jpg" alt="logo_principal" class="logo-login">
    <h1> ACCESO AL SISTEMA </h1>
    <p>Por favor, ingrese su usuario y contraseña.</p>
    <p id="aviso-login" class="rec-ok" style="display:none;"></p>
    <p id="error-login" role="alert" style="display:none; color:#c62828; font-weight:600; margin:8px 0;"></p>


   <form action="MENU.html" method="GET">
        <div class="contenedor-fila">
        <label for="usuario"> <i class="fa-solid fa-user"></i> Nombre de Usuario:</label>
        <div class="contenedor-texto">
       <input type="text" 
               id="usuario"    
               placeholder="Ingrese su nombre de usuario"
               >
        </div>
        </div>


         <div class="contenedor-fila">
        <label for="contrasena"> <i class="fa-solid fa-lock"></i>Contraseña:</label>
        <div class="contenedor-texto">
        <input type="password" id="contrasena" placeholder="Ingrese su contraseña" >
        <button type="button" class="btn-mostrar" onclick="togglePassword('contrasena', this)">
        <i class="fa-solid fa-eye-slash"></i> MOSTRAR 
        </button>     
        </div>
        </div>
        <br>

        <div class="olvidoContra">
        <p><a href="#" onclick="abrirRecuperacion(); return false;"><strong>¿Olvidaste la contraseña?</strong></a></p>
        </div>

      <!-- Cambia el botón de inicio de sesión -->
        <button type="button" class="boton" onclick="iniciarSesion()">
        Iniciar Sesión <i class="fa-solid fa-right-to-bracket"></i>
        </button>

        <!-- VENTANA EMERGENTE (MODAL) -->
        <div id="modalBienvenida" class="modal-fondo">
        <div class="modal-contenido">
        <i class="fa-solid fa-circle-check modal-icono"></i>
        <h2>¡Bienvenido al Sistema!</h2>
        <p>Has ingresado correctamente a Cabeza de Algodón.</p>
        <button type="button" class="btn-cerrar" onclick="cerrarModal()">Aceptar</button>
        </div>
        </div>

    </form>

    <!-- VENTANA: RECUPERAR LA CONTRASEÑA (código de 6 dígitos por correo) -->
    <div id="modalRecuperar" class="modal-fondo">
        <div class="modal-contenido modal-recuperar">
            <h2>Recuperar contraseña</h2>

            <div id="rec-paso1">
                <p>Escriba su usuario o el correo con el que está registrado. Le enviaremos un código de 6 dígitos a ese correo.</p>
                <input type="text" id="rec-usuario" class="rec-campo" placeholder="Usuario o correo" autocomplete="username">
                <button type="button" class="btn-cerrar" onclick="solicitarCodigo()">Enviar código</button>
            </div>

            <div id="rec-paso2" style="display:none;">
                <p class="rec-temporizador">El código vence en <strong id="rec-tiempo">05:00</strong></p>
                <input type="text" id="rec-codigo" class="rec-campo" inputmode="numeric" maxlength="6" placeholder="Código de 6 dígitos" autocomplete="one-time-code">
                <input type="password" id="rec-clave" class="rec-campo" placeholder="Nueva contraseña" autocomplete="new-password">
                <input type="password" id="rec-clave2" class="rec-campo" placeholder="Repita la nueva contraseña" autocomplete="new-password">
                <p class="rec-ayuda">Mínimo 8 caracteres, con letras y números.</p>
                <button type="button" class="btn-cerrar" onclick="restablecerClave()">Cambiar contraseña</button>
                <button type="button" class="rec-enlace" id="rec-reenviar" onclick="solicitarCodigo()" disabled>Reenviar código</button>
            </div>

            <p id="rec-mensaje" class="rec-error"></p>
            <button type="button" class="rec-enlace" onclick="cerrarRecuperacion()">Cancelar</button>
        </div>
    </div>

      <!-- Enlace vital para cargar el script JS -->
    <script src="~/JS/MostrarContra.js" asp-append-version="true"></script>
 </div>
</body>
</html>
