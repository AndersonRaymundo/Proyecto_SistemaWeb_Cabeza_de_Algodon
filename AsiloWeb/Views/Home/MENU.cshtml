<!DOCTYPE html>
<html lang="es">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu-principal</title>
    <link rel="stylesheet" href="~/CSS/dashboard.css" asp-append-version="true"> 
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true">

</head>

<body class="pagina-inicio">
 @await Html.PartialAsync("_Cabecera")
    
    <div class="menu-contenido">
        
 <!-- CONTENEDOR PRINCIPAL -->
<div class="menu-contenido">
    
    <!-- MENÚ LATERAL -->
    @await Html.PartialAsync("_MenuLateral", "inicio")

    <main class="area-trabajo">
            <div class="bienvenida">
                <div>
                    <h1>Bienvenido(a), <span id="bienvenida-nombre">al Sistema</span></h1>
                    <p>Sistema de administración del asilo de ancianos Cabeza de Algodón. Seleccione un módulo para comenzar a trabajar.</p>
                    <span class="fecha-hoy"><i class="fa-solid fa-calendar-day"></i> <span id="fecha-hoy"></span></span>
                </div>
                <img src="~/imagen sesion/logo.jpg" alt="Cabeza de Algodón">
            </div>

            <div class="modulos-titulo">Accesos rápidos</div>
            <div class="modulos">
                <a href="/Residentes" class="tarjeta-modulo" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO">
                    <div class="icono"><i class="fa-solid fa-hospital-user"></i></div>
                    <strong>Pacientes</strong>
                    <span class="desc">Registro, edición y estado de los residentes del asilo.</span>
                </a>
                <a href="/Citas" class="tarjeta-modulo" data-rol="ADMINISTRADOR,DOCTOR,ENFERMERO,FUNDACION">
                    <div class="icono"><i class="fa-solid fa-calendar-check"></i></div>
                    <strong>Solicitudes y Citas</strong>
                    <span class="desc">Remisiones, agenda de la Fundación y visitas médicas.</span>
                </a>
                <a href="/Historial" class="tarjeta-modulo" data-rol="ADMINISTRADOR,DOCTOR">
                    <div class="icono"><i class="fa-solid fa-notes-medical"></i></div>
                    <strong>Historial Médico</strong>
                    <span class="desc">Expediente clínico completo de cada residente.</span>
                </a>
                <a href="/LaboratorioFarmacia" class="tarjeta-modulo" data-rol="ADMINISTRADOR,DOCTOR,FARMACIA,LABORATORIO">
                    <div class="icono"><i class="fa-solid fa-vials"></i></div>
                    <strong>Lab y Farmacia</strong>
                    <span class="desc">Resultados de exámenes y despacho de medicamentos.</span>
                </a>
                <a href="/Reportes" class="tarjeta-modulo" data-rol="ADMINISTRADOR,DOCTOR">
                    <div class="icono"><i class="fa-solid fa-chart-line"></i></div>
                    <strong>Reportes</strong>
                    <span class="desc">Informes en PDF con los datos del sistema.</span>
                </a>
                <a href="/Caja" class="tarjeta-modulo" data-rol="ADMINISTRADOR">
                    <div class="icono"><i class="fa-solid fa-cash-register"></i></div>
                    <strong>Caja y Finanzas</strong>
                    <span class="desc">Cobros, donaciones, gastos y cuentas por cobrar.</span>
                </a>
                <a href="/Paginas/Configuracion" class="tarjeta-modulo" data-rol="ADMINISTRADOR">
                    <div class="icono"><i class="fa-solid fa-gear"></i></div>
                    <strong>Configuración</strong>
                    <span class="desc">Parámetros generales de la institución.</span>
                </a>
            </div>
        </main>

    </div>
<!-- SCRIPT CONTROLADOR DE ROLES -->
    <script src="~/JS/roles.js" asp-append-version="true"></script>
</body>
    </html>